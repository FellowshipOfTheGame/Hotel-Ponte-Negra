[sub_resource type="GDScript" id="GDScript_4lyxp"]
script/source = "extends CanvasLayer

var menu_anterior: Node 

func voltar() -> void:
	$Control/VBoxContainer/TabContainer/Controles.save()
	
	if menu_anterior:
		menu_anterior.show()
		
	queue_free()
"

[sub_resource type="GDScript" id="GDScript_Controles"]
script/source = "extends Control

const confPath = \"user://config\"

func _init() -> void: # funcao load()
	if!FileAccess.file_exists(confPath):return
	var conf := ConfigFile.new();conf.load(confPath)
	for acao in conf.get_section_keys(\"controles\"):
		var key :String= conf.get_value(\"controles\",acao)
		var event:=InputMap.action_get_events(acao)[0]
		if event is InputEventKey:
			event.keycode=OS.find_keycode_from_string(key)

func _input(event: InputEvent) -> void:
	if event.is_action_pressed(\"ui_cancel\"):
		get_viewport().set_input_as_handled()
		$\"../..\".voltar()

func save()->void:
	var conf := ConfigFile.new();conf.load(confPath)

	for acao in InputMap.get_actions():
		if acao.begins_with(\"ui_\"): return
		if !InputMap.action_get_events(acao): return

		var event := InputMap.action_get_events(acao)[0]
		var text := event.as_text()
		if event is InputEventKey:
			text=text.get_slice(\" \",0)
		elif event is InputEventJoypadMotion:
			text=text.get_slice(\"(\",1).get_slice(\",\",0)
		conf.set_value(\"controles\",acao,text)
	conf.save(confPath)
"

[sub_resource type="GDScript" id="GridContainer"]
script/source = "@tool
extends GridContainer

func _init() -> void:
	if Engine.is_editor_hint():
		InputMap.load_from_project_settings()
	for acao in InputMap.get_actions():if(
			!acao.begins_with(\"ui_\")and
			!acao.begins_with(\"_\")):
		var label := Label.new()
		label.text=acao.replace(\"_\",\" \").replace(\"movimento\",\"mover para\").capitalize()
		add_child(label)
		var button := Button.new()
		button.name=acao
		button.set_script(preload(\"res://scripts/menus/opcoes/definirControle.gd\"))
		button.size_flags_horizontal=Control.SIZE_EXPAND_FILL
		button.custom_minimum_size=Vector2(0,50)
		add_child(button)
"

