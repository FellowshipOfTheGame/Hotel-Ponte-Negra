[sub_resource type="GDScript" id="MenuPrincipal"]
script/source = "extends CanvasLayer

@onready var audio = AudioStreamPlayer.new()

func _ready() -> void:
	add_child(audio)
	audio.stream = preload(\"res://assets/audio/background_music/terror_ambient2.mp3\")
	audio.stream.loop = true
	audio.play()


func jogar() -> void:
	$Tela_Fundo.iniciar_transicao()
	await $Tela_Fundo.transicao_concluida
	get_tree().change_scene_to_file(\"res://scenes/levels/Level1.tscn\")
	

func sair() -> void:
	get_tree().quit()

func opcoes() -> void:
	var menu := preload(\"res://scenes/menus/menuOpcoes.tscn\").instantiate()
	menu.menu_anterior = self 
	get_parent().add_child(menu)
	
	self.hide()
"

